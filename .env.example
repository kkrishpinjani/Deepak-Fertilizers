MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=

# Real — checked server-side by app/api/login/route.ts, gates every page via
# middleware.ts. SESSION_SECRET signs the session cookie; set your own random
# string per environment.
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_SECRET=

# Real — dedicated Docker container for this project (docker-compose.yml).
# Start with: docker compose up -d
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Real — local Ollama, no cloud key needed. Requires `ollama serve` running
# and the model pulled (`ollama pull qwen2.5:7b`).
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Dormant — set DATA_MODE=snowflake and fill these in to activate the
# Snowflake connector and Cortex Analyst REST client. Leave blank to
# stay on MySQL (the default).
DATA_MODE=mysql
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=SAP_ANAPLAN_DEMO
SNOWFLAKE_SCHEMA=CONFORMED
SNOWFLAKE_HOST=
SNOWFLAKE_PAT=
CORTEX_SEMANTIC_VIEW=SAP_ANAPLAN_DEMO.CORTEX.SALES_PERFORMANCE_ANALYST
